---
import { getEntry } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { docsVersion } from "../../../lib/termina";

// The docs landing: the introduction, at /docs/v-<version>/.
export function getStaticPaths() {
  return [{ params: { version: docsVersion } }];
}

const entry = await getEntry("docs", "introduction");
if (!entry) throw new Error("src/content/docs/introduction.md is missing");
---

<DocsLayout entry={entry} />
