---
import { href } from "../lib/site";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

interface Props {
  entry: CollectionEntry<"docs">;
}
const { entry } = Astro.props;
const base = href("/docs");

// Build the ordered sidebar: categories in a fixed order, docs by `order`.
const CATEGORY_ORDER = [
  "Getting started",
  "Using Termina",
  "Customization",
  "Help",
];

const pages = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const cats = [...new Set([...CATEGORY_ORDER, ...pages.map((p) => p.data.category)])].filter((c) =>
  pages.some((p) => p.data.category === c),
);

type Page = (typeof pages)[number];
const pageHref = (p: Page) => (p.id === "introduction" ? base : `${base}/${p.id}`);

// Flat order for prev/next.
const flat = cats.flatMap((c) => pages.filter((p) => p.data.category === c));
const idx = flat.findIndex((p) => p.id === entry.id);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;

const reference = [
  { href: href("/keybindings"), label: "Keybindings" },
  { href: "https://github.com/adriandeleon/Termina/blob/master/CHANGELOG.md", label: "Changelog" },
  { href: "https://github.com/adriandeleon/Termina/releases", label: "Releases" },
];

const { Content } = await render(entry);

// The FAQ page is a flat list of `## Question?` headings followed by their
// answer, which is exactly the shape schema.org's FAQPage wants. Emitting it
// lets search engines show the questions directly. Built from the raw body so
// it can never drift from what the page renders; answers are flattened to
// plain text (links and code spans stripped) and capped, since the schema is a
// summary rather than a copy of the page.
const faqJsonLd =
  entry.id === "faq"
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        // Split rather than a lookahead regex: an earlier version ended the
        // answer at `(?=^##\s|\Z)`, but \Z is not a JavaScript anchor (it
        // matches a literal "Z"), so the final question never matched and the
        // page shipped 11 of its 12 questions.
        mainEntity: entry.body
          .split(/^##\s+/m)
          .slice(1)
          .map((block) => {
            const nl = block.indexOf("\n");
            const q = (nl === -1 ? block : block.slice(0, nl)).trim();
            const a = nl === -1 ? "" : block.slice(nl + 1);
            const text = a
              .replace(/```[\s\S]*?```/g, " ")
              .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
              .replace(/[`*_>#]/g, "")
              .replace(/\s+/g, " ")
              .trim()
              .slice(0, 500);
            return { q, text };
          })
          .filter((x) => x.q && x.text)
          .map((x) => ({
            "@type": "Question",
            name: x.q,
            acceptedAnswer: { "@type": "Answer", text: x.text },
          })),
      }
    : null;
---

<Layout
  title={`${entry.data.title} — Termina Docs`}
  description={entry.data.description ?? entry.data.title}
  ogImage="og/docs.png"
>
  {
    faqJsonLd && faqJsonLd.mainEntity.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )
  }
  <div class="docs-wrap">
    <aside class="docs-sidebar">
      <nav>
        {
          cats.map((c) => (
            <div class="docs-cat">
              <h3>{c}</h3>
              {pages
                .filter((p) => p.data.category === c)
                .map((p) => (
                  <a href={pageHref(p)} class={p.id === entry.id ? "active" : ""}>
                    {p.data.beta && <span class="beta-pill">Beta</span>}
                    {p.data.title}
                  </a>
                ))}
            </div>
          ))
        }
        <div class="docs-cat">
          <h3>Reference</h3>
          {reference.map((r) => <a href={r.href}>{r.label}</a>)}
        </div>
      </nav>
    </aside>

    <article class="docs-content doc" data-pagefind-body data-pagefind-meta="kind:Docs">
      <h1>
        {entry.data.beta && <span class="beta-pill">Beta</span>}
        {entry.data.title}
      </h1>
      <Content />

      <nav class="docs-pager" data-pagefind-ignore>
        {
          prev ? (
            <a class="prev" href={pageHref(prev)}>
              <span>← Previous</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={pageHref(next)}>
              <span>Next →</span>
              {next.data.title}
            </a>
          )
        }
      </nav>
    </article>
  </div>
</Layout>

<style>
  .docs-wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
  }

  .docs-cat {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .docs-cat h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin: 0 0 0.4rem;
  }

  .docs-cat a {
    color: var(--muted);
    font-size: 0.92rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border-left: 2px solid transparent;
  }

  .docs-cat a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .docs-cat a.active {
    color: var(--text);
    background: var(--bg-soft);
    border-left-color: var(--accent);
  }

  /* Beta pill leads the title/sidebar entry, so the pills line up. */
  .docs-cat a .beta-pill,
  .docs-content h1 .beta-pill {
    margin-left: 0;
    margin-right: 0.4rem;
  }

  /* the .doc prose styles come from Layout's global stylesheet */
  .docs-content {
    max-width: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .docs-content h1 {
    margin-top: 0;
  }

  .docs-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .docs-pager a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    background: var(--bg-soft);
  }

  .docs-pager a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .docs-pager a.next {
    text-align: right;
    margin-left: auto;
  }

  .docs-pager span {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .docs-wrap {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .docs-sidebar {
      position: static;
    }
    .docs-cat {
      margin-bottom: 1rem;
    }
  }
</style>
