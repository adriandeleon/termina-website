---
// ⌘K / "/" site search, styled like Termina's own command palette (Editora's, ported with the site). Full-text
// over the whole site via Pagefind (static, self-hosted — the index ships under
// /pagefind and is generated by the `build` script; nothing phones home).
//
// The Pagefind runtime only exists after `pagefind --site dist` runs, so in
// `astro dev` the import 404s and the modal shows a "build the site" hint.
// Test search with:  npm run build && npm run preview
const base = import.meta.env.BASE_URL;
const pagefindPath = `${base}/pagefind/pagefind.js`.replace(/\/{2,}/g, "/");
---

<button
  id="search-open"
  class="search-trigger"
  type="button"
  title="Search (⌘K)"
  aria-label="Search the site"
  aria-keyshortcuts="Meta+K Control+K"
>
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <span class="search-trigger-label">Search</span>
  <kbd class="search-trigger-kbd" id="search-kbd">⌘K</kbd>
</button>

<div id="search-modal" class="search-modal" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <div class="search-inputrow">
      <svg class="search-inputrow-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search docs, features, and news…"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Search query"
        aria-controls="search-results"
      />
      <kbd class="search-esc">Esc</kbd>
    </div>
    <div id="search-results" class="search-results" role="listbox" aria-label="Search results"></div>
    <div id="search-status" class="search-status">
      Type to search the docs, features, and news.
    </div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
      <span><kbd>↵</kbd> to open</span>
      <span><kbd>esc</kbd> to close</span>
      <span class="search-foot-by">Search by Pagefind</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ pagefindPath, base }}>
  (function () {
    const openBtn = document.getElementById("search-open");
    const modal = document.getElementById("search-modal");
    const input = document.getElementById("search-input");
    const resultsEl = document.getElementById("search-results");
    const statusEl = document.getElementById("search-status");
    if (!openBtn || !modal || !input || !resultsEl) return;

    // Show the right modifier hint per platform.
    const isMac = /Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent);
    const kbd = document.getElementById("search-kbd");
    if (kbd && !isMac) kbd.textContent = "Ctrl K";

    // The trigger lives in the nav, but `.site-nav` sets `backdrop-filter`,
    // which makes it a *containing block for position:fixed descendants* — so
    // a modal rendered inside it is clamped to the header strip (measured
    // 1280x88 instead of the viewport) with its input unreachable. Re-parent
    // the modal to <body> so `position: fixed; inset: 0` really means the
    // viewport. Astro's scoped-style attributes live on the elements, so they
    // travel with the node and the CSS still applies.
    if (modal.parentElement !== document.body) document.body.appendChild(modal);

    let pf = null;
    let pfState = "idle"; // idle | loading | ready | failed
    let items = [];
    let active = -1;
    let lastReturn = null;

    async function ensurePagefind() {
      if (pfState === "ready" || pfState === "failed") return pf;
      pfState = "loading";
      try {
        pf = await import(pagefindPath);
        if (pf.options) {
          // Results are indexed relative to dist/, so they need the base the site is served under.
          await pf.options({ excerptLength: 22, baseUrl: `${base}/`.replace(/\/{2,}/g, "/") });
        }
        pfState = "ready";
      } catch (e) {
        pfState = "failed";
      }
      return pf;
    }

    function openModal() {
      if (!modal.hidden) return;
      lastReturn = document.activeElement;
      modal.hidden = false;
      document.body.style.overflow = "hidden";
      input.value = "";
      render([]);
      setStatus("Type to search the docs, features, and news.");
      // Focus immediately and again after paint: if the first attempt lands
      // before the modal is laid out the field stays unfocused, and then every
      // key (including Esc) goes to <body> instead of the search box.
      input.focus();
      requestAnimationFrame(() => input.focus());
      ensurePagefind().then(() => {
        if (pfState === "failed") {
          setStatus(
            "Search is generated at build time. Run “npm run build && npm run preview” to try it locally.",
          );
        }
      });
    }

    function closeModal() {
      if (modal.hidden) return;
      modal.hidden = true;
      document.body.style.overflow = "";
      if (lastReturn && lastReturn.focus) lastReturn.focus();
    }

    function setStatus(msg) {
      statusEl.textContent = msg || "";
      statusEl.style.display = msg ? "" : "none";
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"]/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c],
      );
    }

    function render(list) {
      items = list;
      active = list.length ? 0 : -1;
      if (!list.length) {
        resultsEl.innerHTML = "";
        return;
      }
      resultsEl.innerHTML = list
        .map((r, i) => {
          const kind = r.kind ? `<span class="sr-kind">${escapeHtml(r.kind)}</span>` : "";
          return (
            `<a class="sr-item${i === 0 ? " is-active" : ""}" role="option" href="${escapeHtml(r.url)}" data-i="${i}">` +
            `<span class="sr-head">${kind}<span class="sr-title">${escapeHtml(r.title)}</span></span>` +
            `<span class="sr-excerpt">${r.excerpt || ""}</span>` +
            `</a>`
          );
        })
        .join("");
      // Mouse selection.
      resultsEl.querySelectorAll(".sr-item").forEach((el) => {
        el.addEventListener("mousemove", () => setActive(+el.dataset.i));
        el.addEventListener("click", (e) => {
          // let the anchor navigate; nothing else needed
        });
      });
    }

    function setActive(i) {
      if (i < 0 || i >= items.length || i === active) return;
      const nodes = resultsEl.querySelectorAll(".sr-item");
      if (nodes[active]) nodes[active].classList.remove("is-active");
      active = i;
      if (nodes[active]) {
        nodes[active].classList.add("is-active");
        nodes[active].scrollIntoView({ block: "nearest" });
      }
    }

    function move(delta) {
      if (!items.length) return;
      let i = active + delta;
      if (i < 0) i = items.length - 1;
      if (i >= items.length) i = 0;
      setActive(i);
    }

    async function runSearch(q) {
      await ensurePagefind();
      if (pfState !== "ready") return;
      if (!q.trim()) {
        render([]);
        setStatus("Type to search the docs, features, and news.");
        return;
      }
      const search = await pf.debouncedSearch(q);
      if (search === null) return; // superseded by a newer query
      if (!search.results.length) {
        render([]);
        setStatus(`No results for “${q}”.`);
        return;
      }
      setStatus("");
      const top = search.results.slice(0, 8);
      const data = await Promise.all(top.map((r) => r.data()));
      render(
        data.map((d) => ({
          url: d.url,
          title: (d.meta && d.meta.title) || d.url,
          kind: d.meta && d.meta.kind,
          excerpt: d.excerpt,
        })),
      );
    }

    // Events
    openBtn.addEventListener("click", openModal);
    modal.querySelectorAll("[data-search-close]").forEach((el) =>
      el.addEventListener("click", closeModal),
    );
    input.addEventListener("input", () => runSearch(input.value));

    // Clicking anywhere in the panel (but not a result link) returns focus to
    // the field, so the keyboard is never stranded.
    document.querySelector(".search-panel").addEventListener("mousedown", (e) => {
      if (!e.target.closest("a")) {
        e.preventDefault();
        input.focus();
      }
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || (e.ctrlKey && e.key === "n")) {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp" || (e.ctrlKey && e.key === "p")) {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        const nodes = resultsEl.querySelectorAll(".sr-item");
        if (nodes[active]) window.location.href = nodes[active].getAttribute("href");
      } else if (e.key === "Escape") {
        e.preventDefault();
        closeModal();
      }
    });

    // Global shortcuts: ⌘/Ctrl-K anywhere; "/" when not typing in a field.
    document.addEventListener("keydown", (e) => {
      // Escape is handled globally, not just on the input: if focus ever sits
      // outside the field the modal must still be closable — otherwise the
      // scroll lock makes the whole page feel frozen.
      if (e.key === "Escape" && !modal.hidden) {
        e.preventDefault();
        closeModal();
        return;
      }
      if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
        e.preventDefault();
        modal.hidden ? openModal() : closeModal();
        return;
      }
      if (modal.hidden && e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const t = e.target;
        const typing =
          t &&
          (t.tagName === "INPUT" ||
            t.tagName === "TEXTAREA" ||
            t.isContentEditable);
        if (!typing) {
          e.preventDefault();
          openModal();
        }
      }
    });
  })();
</script>

<style>
  /* trigger in the nav */
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.55rem 0.3rem 0.7rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .search-trigger:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .search-trigger-kbd {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.02rem 0.35rem;
  }

  /* The nav bar is capped at --maxw (980px) on every desktop size, and eight
     links plus the theme picker already fill it: a labelled trigger needs
     125px the row doesn't have, which pushed the theme picker onto a second
     line. Keep the trigger a compact icon (the shortcut lives in the tooltip
     and the modal footer) so the header stays one row. */
  .search-trigger-label,
  .search-trigger-kbd {
    display: none;
  }
  .search-trigger {
    padding: 0.35rem;
  }

  /* modal */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 10vh 1rem 1rem;
  }
  .search-modal[hidden] {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 55%, rgba(0, 0, 0, 0.6));
    backdrop-filter: blur(3px);
  }
  .search-panel {
    position: relative;
    width: min(640px, 100%);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--bg-soft) 94%, var(--bg));
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    animation: search-pop 0.12s ease both;
  }
  @keyframes search-pop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .search-inputrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .search-inputrow-icon {
    color: var(--faint);
    flex: none;
  }
  #search-input {
    flex: 1;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: transparent;
    border: 0;
    outline: none;
    padding: 0.1rem 0;
  }
  #search-input::placeholder {
    color: var(--faint);
  }
  .search-esc {
    flex: none;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.05rem 0.4rem;
  }

  .search-results {
    overflow-y: auto;
    padding: 0.4rem;
  }
  :global(.sr-item) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.55rem 0.7rem;
    border-radius: 9px;
    color: var(--text);
  }
  :global(.sr-item:hover) {
    text-decoration: none;
  }
  :global(.sr-item.is-active) {
    background: var(--accent-soft);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  :global(.sr-head) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  :global(.sr-kind) {
    flex: none;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
  }
  :global(.sr-title) {
    font-weight: 600;
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.sr-excerpt) {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.sr-excerpt mark) {
    background: color-mix(in srgb, var(--warn) 30%, transparent);
    color: var(--text);
    border-radius: 3px;
    padding: 0 0.1em;
  }

  .search-status {
    padding: 1.25rem 1rem;
    color: var(--faint);
    font-size: 0.9rem;
    text-align: center;
  }
  .search-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--border-soft);
    color: var(--faint);
    font-size: 0.75rem;
  }
  .search-foot kbd {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 0.3em;
    margin-right: 0.1em;
  }
  .search-foot-by {
    margin-left: auto;
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .search-foot-by {
      display: none;
    }
  }
</style>
